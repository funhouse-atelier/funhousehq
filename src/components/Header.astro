---
import { Image } from 'astro:assets';
import logo from '../assets/logo-graphic-cropped.png';
import Button from './ui/Button.astro';
import { SITE, NAV } from '../data/site';
---

<header class="sticky top-0 z-50 border-b-3 border-navy bg-cream/90 backdrop-blur-md">
  <div class="container flex min-h-18 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label={`${SITE.name} home`}>
      <Image src={logo} alt="" width={52} height={52} densities={[1, 2]} loading="eager" />
      <span class="font-display text-[1.35rem] tracking-[0.02em] text-flame [-webkit-text-stroke:0.6px_var(--color-navy)]">
        Funhouse <span class="text-marigold-600">Atelier</span>
      </span>
    </a>

    <!-- CSS-only mobile menu: the checkbox is the toggle, nav reacts with peer-checked -->
    <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-label="Toggle menu" />
    <label
      for="nav-toggle"
      class="grid size-11 cursor-pointer place-items-center rounded-xl border-3 border-navy bg-cream-100 peer-focus-visible:outline-3 peer-focus-visible:outline-flame lg:hidden"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </label>

    <nav
      aria-label="Main"
      class="absolute inset-x-0 top-full hidden flex-col items-stretch gap-3 border-b-3 border-navy bg-cream px-5 pt-4 pb-6 peer-checked:flex lg:static lg:flex lg:flex-row lg:items-center lg:gap-7 lg:border-0 lg:bg-transparent lg:p-0"
    >
      <ul class="flex flex-col gap-1 lg:flex-row lg:gap-5.5">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block border-b-3 border-transparent py-2.5 font-head text-lg font-medium text-navy no-underline hover:border-marigold lg:py-1 lg:text-base"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={SITE.bookingUrl} variant="primary" size="sm" target="_blank" rel="noopener">Book a call</Button>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.querySelectorAll<HTMLAnchorElement>('header nav a').forEach((a) =>
    a.addEventListener('click', () => {
      const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
      if (t) t.checked = false;
    }),
  );
</script>
