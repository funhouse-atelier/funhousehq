{
  "experimentalTernaries": true,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "quoteProps": "consistent",
  "singleAttributePerLine": true,
  "tailwindStylesheet": "./src/styles/global.css",
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    }
  ]
}
